{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "incremental": false,
    "isolatedModules": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": "./build",
    "rootDir": ".",
    "target": "ES2020",
    "types": ["node"]
  },
  "include": [
    "lib/db.ts",
    "lib/supabase.ts",
    "lib/types.ts",
    "lib/capture/constants.ts",
    "lib/capture/policy.ts",
    "lib/capture/pipeline.ts",
    "lib/capture/task.ts",
    "lib/auth/redirect.ts",
    "lib/api/boundary.ts",
    "lib/auth/errors.ts",
    "lib/learning/fallback.ts",
    "lib/runtime/health.ts",
    "lib/brand/identity.ts",
    "app/components/brand/BrandPrimitives.tsx",
    "app/components/brand/ProductArtwork.tsx",
    "app/components/capture/RecordingPanel.tsx",
    "app/components/capture/ProcessingView.tsx",
    "app/components/capture/CaptureSourceTabs.tsx",
    "app/components/shell/AppShell.tsx",
    "app/components/workspace/HomeWorkspace.tsx",
    "app/components/workspace/CoursesWorkspace.tsx",
    "app/components/workspace/SharedWorkspace.tsx",
    "app/components/workspace/NotaraWorkspace.tsx",
    "app/components/workspace/WorkspaceAmbientHeader.tsx",
    "app/api/health/route.ts",
    "app/api/version/route.ts"
  ],
  "exclude": ["node_modules", "build"]
}
